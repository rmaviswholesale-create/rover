{
  "name": "@rtrvr-ai/rover-mcp",
  "version": "3.0.0",
  "license": "FSL-1.1-Apache-2.0",
  "description": "MCP server — Rover Agent Task Protocol wrapper for antigravity IDE sub-browser agents",
  "author": "RTRVR AI, INC. <support@rtrvr.ai>",
  "homepage": "https://www.rtrvr.ai/rover",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtrvr-ai/rover.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "rover",
    "mcp",
    "model-context-protocol",
    "web-agent",
    "ai-agent",
    "browser-agent",
    "ide-agent",
    "antigravity",
    "agentic",
    "automation"
  ],
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rover-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node --import tsx/esm src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@rover/tsconfig": "workspace:*",
    "@types/node": "^20.11.30",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
